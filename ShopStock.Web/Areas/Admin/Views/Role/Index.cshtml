@using ShopStock.Domain.ViewModels.Role
@model IEnumerable<AdminCreateRoleViewModel>

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                مدیریت نقش‌ها
            </h4>

            <p class="text-muted mb-0">
                مشاهده و مدیریت نقش‌های سیستم
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Role"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bx bx-plus me-1"></i>
            افزودن نقش

        </a>

    </div>


    <!-- Role Card -->
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                لیست نقش‌ها
            </h5>

            <span class="badge bg-label-primary">
                تعداد: @(Model?.Count() ?? 0)
            </span>

        </div>


        <div class="table-responsive">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th style="width:80px;">
                            #
                        </th>

                        <th>
                            نام نقش
                        </th>

                        <th class="text-center">
                            عملیات
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        var row = 1;

                        foreach (var role in Model)
                        {
                            <tr>

                                <td>
                                    @row
                                </td>

                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="avatar me-3">

                                            <span class="avatar-initial rounded bg-label-primary">

                                                <i class="bx bx-shield"></i>

                                            </span>

                                        </div>

                                        <div>

                                            <h6 class="mb-0">
                                                @role.RoleName
                                            </h6>

                                            <small class="text-muted">
                                                شناسه نقش: @role.Id
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td class="text-center">

                                    <div class="d-inline-flex gap-1">

                                        <!-- Permission -->
                                        <a asp-area="Admin"
                                           asp-controller="Role"
                                           asp-action="Permission"
                                           asp-route-id="@role.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="مدیریت دسترسی‌ها">

                                            <i class="bx bx-lock-alt"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-area="Admin"
                                           asp-controller="Role"
                                           asp-action="Edit"
                                           asp-route-id="@role.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="ویرایش">

                                            <i class="bx bx-edit"></i>

                                        </a>


                                        <!-- Delete -->
                                        <form asp-area="Admin"
                                              asp-controller="Role"
                                              asp-action="Delete"
                                              asp-route-id="@role.Id"
                                              method="get"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="حذف"
                                                  >

                                                <i class="bx bx-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            row++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="3"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bx bx-shield-x fs-1 d-block mb-2"></i>

                                    <h6>
                                        هنوز هیچ نقشی ایجاد نشده است.
                                    </h6>

                                    <a asp-area="Admin"
                                       asp-controller="Role"
                                       asp-action="Create"
                                       class="btn btn-primary btn-sm mt-2">

                                        <i class="bx bx-plus me-1"></i>
                                        ایجاد اولین نقش

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>