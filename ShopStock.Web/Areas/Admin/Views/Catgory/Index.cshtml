
@using ShopStock.Domain.ViewModels.Catgory

@model AdminFilterCatgoryViewModel

@{
    ViewData["Title"] = "مدیریت گروه‌ها";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                مدیریت گروه‌ها
            </h4>

            <p class="text-muted mb-0">
                مدیریت و مشاهده گروه‌های فروشگاه
            </p>

            <a asp-area="Admin"
               asp-controller="Catgory"
               asp-action="Index"
               class="btn btn-primary">

                <i class="bx bx-plus me-1"></i>
                برگشت به لیست گروه ها

            </a>
            <a asp-area="Admin"
               asp-controller="Catgory"
               asp-route-id="@Model.ParentId"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bx bx-plus me-1"></i>
                افزودن گروه

            </a>



        </div>


  

    </div>


    <!-- Search / Filter -->
    <div class="card mb-4">

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Catgory"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">

                        <label asp-for="Tittle"
                               class="form-label">
                            نام گروه
                        </label>

                        <input asp-for="Tittle"
                               class="form-control"
                               placeholder="نام گروه را وارد کنید..." />

                    </div>


                    <div class="col-md-4">

                        <label asp-for="DeleteResult"
                               class="form-label">
                            وضعیت
                        </label>

                        <select asp-for="DeleteResult"
                                class="form-select">

                            <option value="All">
                                همه
                            </option>

                            <option value="NotDelete">
                                حذف نشده
                            </option>

                            <option value="Delete">
                                حذف شده
                            </option>

                        </select>

                    </div>


                    <div class="col-md-3">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bx bx-search me-1"></i>
                                جستجو

                            </button>

                            <a asp-area="Admin"
                               asp-controller="Catgory"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                پاک کردن

                            </a>

                       

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Categories Table -->
    <div class="card">

        <div class="card-header">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    لیست گروه‌ها
                </h5>

                <span class="badge bg-label-primary">
                    تعداد: @(Model.Entities?.Count ?? 0)
                </span>

            </div>

        </div>


        <div class="table-responsive text-nowrap">

            <table class="table">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>نام گروه</th>

                        <th>گروه والد</th>

                        <th>وضعیت</th>

                        <th>عملیات</th>

                    </tr>

                </thead>


                <tbody class="table-border-bottom-0">

                    @if (Model.Entities != null && Model.Entities.Any())
                    {
                        foreach (var category in Model.Entities)
                        {
                            <tr>

                                <!-- Id -->
                                <td>
                                    @category.Id
                                </td>


                                <!-- Title + Image -->
                                <td>

                                    <div class="d-flex align-items-center">

                                        @if (!string.IsNullOrEmpty(category.ImageName))
                                        {
                                            <img src="~/CatgoriesImage/@category.ImageName"
                                                 class="rounded-circle me-3"
                                                 style="width:40px;height:40px;object-fit:cover;"
                                                 alt="@category.Tittle" />
                                        }
                                        else
                                        {
                                            <div class="avatar avatar-sm me-3">

                                                <span class="avatar-initial rounded-circle bg-label-primary">

                                                    @(string.IsNullOrEmpty(category.Tittle)
                                                        ? "؟"
                                                        : category.Tittle.Substring(0, 1))

                                                </span>

                                            </div>
                                        }

                                        <strong>
                                            @category.Tittle
                                        </strong>

                                    </div>

                                </td>


                                <!-- Parent -->
                                <td>

                                    @if (category.ParentId.HasValue)
                                    {
                                        <span class="badge bg-label-info">
                                            زیرگروه
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-secondary">
                                            گروه اصلی
                                        </span>
                                    }

                                </td>


                                <!-- Delete Status -->
                                <td>

                                    @if (category.IsDeleted)
                                    {
                                        <span class="badge bg-label-danger">
                                            حذف شده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-success">
                                            فعال
                                        </span>
                                    }

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="dropdown">

                                        <button type="button"
                                                class="btn p-0 dropdown-toggle hide-arrow"
                                                data-bs-toggle="dropdown">

                                            <i class="bx bx-dots-vertical-rounded"></i>

                                        </button>


                                        <div class="dropdown-menu">

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Catgory"
                                               asp-action="Edit"
                                               asp-route-id="@category.Id">

                                                <i class="bx bx-edit-alt me-1"></i>
                                                ویرایش

                                            </a>


                                            <a class="dropdown-item text-danger"
                                               asp-area="Admin"
                                               asp-controller="Catgory"
                                               asp-action="Delete"
                                               asp-route-id="@category.Id">

                                                <i class="bx bx-trash me-1"></i>
                                                حذف

                                            </a>

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Catgory"
                                               asp-action="SubCatgory"
                                               asp-route-id="@category.Id">

                                                <i class="bx bx-edit-alt me-1"></i>
                                                زیر گروه

                                            </a>


                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bx bx-category fs-1 mb-2"></i>

                                    <p class="mb-0">
                                        گروهی پیدا نشد
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <hr />

            <partial name="_AdminPagination"
                     model="@Model.GetCurrent()" />

        </div>

    </div>

</div>
```
