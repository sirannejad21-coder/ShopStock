@using ShopStock.Domain.Models.Users
@model User

@{
    ViewData["Title"] = "حذف کاربر";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                حذف کاربر
            </h4>

            <p class="text-muted mb-0">
                بررسی اطلاعات کاربر قبل از حذف
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bx bx-arrow-back me-1"></i>
            بازگشت به کاربران

        </a>

    </div>


    <div class="row">

        <!-- User Information -->
        <div class="col-xl-8 col-lg-8 col-md-12">

            <div class="card">

                <div class="card-header">

                    <h5 class="mb-0 text-danger">
                        <i class="bx bx-trash me-1"></i>
                        حذف کاربر
                    </h5>

                </div>


                <div class="card-body">

                    <div class="alert alert-danger">

                        <i class="bx bx-error-circle me-1"></i>

                        آیا مطمئن هستید که می‌خواهید این کاربر را حذف کنید؟

                        <br />

                        این عملیات را با دقت انجام دهید.

                    </div>


                    <!-- First Name -->
                    <div class="row mb-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                نام
                            </label>

                            <input value="@Model.FirstName"
                                   class="form-control"
                                   readonly />

                        </div>


                        <!-- Last Name -->
                        <div class="col-md-6">

                            <label class="form-label">
                                نام خانوادگی
                            </label>

                            <input value="@Model.LastName"
                                   class="form-control"
                                   readonly />

                        </div>

                    </div>


                    <!-- Username / Email -->
                    <div class="row mb-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                نام کاربری
                            </label>

                            <input value="@Model.UserName"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                ایمیل
                            </label>

                            <input value="@Model.Email"
                                   class="form-control"
                                   readonly />

                        </div>

                    </div>


                    <!-- Mobile / NationalCode -->
                    <div class="row mb-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                شماره موبایل
                            </label>

                            <input value="@Model.Mobile"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                کد ملی
                            </label>

                            <input value="@Model.NationalCode"
                                   class="form-control"
                                   readonly />

                        </div>


                        @if (Model.UserRoles != null && Model.UserRoles.Any())
                        {
                            <div class="mb-4">

                                <label class="form-label fw-bold">
                                    نقش‌های کاربر
                                </label>
                                
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var userRole in Model.UserRoles)
                                    {
                                        <span class="badge bg-primary text-white px-3 py-2">
                                            <i class="bx bx-shield me-1"></i>
                                            @userRole.Role.RoleName
                                        </span>
                                    }
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                این کاربر هیچ نقشی ندارد.
                            </div>
                        }


                    </div>


                    <!-- Status -->
                    <div class="mb-4">

                        <label class="form-label">
                            وضعیت
                        </label>

                        <div>

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    فعال
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    غیرفعال
                                </span>
                            }

                        </div>

                    </div>


                    <!-- Buttons -->
                    <form asp-area="Admin"
                          asp-controller="Users"
                          asp-action="DeleteConfirmed"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bx bx-trash me-1"></i>
                                حذف کاربر

                            </button>


                            <a asp-area="Admin"
                               asp-controller="Users"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                انصراف

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        <!-- Avatar -->
        <div class="col-xl-4 col-lg-4 col-md-12">

            <div class="card">

                <div class="card-body text-center">

                    <img src="~/Avatar/@Model.Avatar"
                         alt="Avatar"
                         class="rounded-circle border mb-3"
                         style="width:140px;height:140px;object-fit:cover;" />

                    <h5 class="mb-1">

                        @Model.FirstName @Model.LastName

                    </h5>

                    <p class="text-muted mb-0">

                        @Model.UserName

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
