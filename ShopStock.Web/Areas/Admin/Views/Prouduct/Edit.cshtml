@using ShopStock.Domain.ViewModels.Prouduct
@using Microsoft.AspNetCore.Mvc.Rendering
@model AdminEditProuductViewModel

@{
    ViewData["Title"] = "ویرایش محصول";
}

<link rel="stylesheet"
      href="~/AdminAssests/assets/vendor/libs/tagify/tagify.css">

<div class="container-xxl flex-grow-1 container-p-y">

    ```
    <!-- ========================================= -->
    <!-- Header -->
    <!-- ========================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-area="Admin"
           asp-controller="Prouduct"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bx bx-arrow-back me-1"></i>
            بازگشت به محصولات

        </a>

    </div>


    <!-- ========================================= -->
    <!-- Form -->
    <!-- ========================================= -->

    <form asp-area="Admin"
          asp-controller="Prouduct"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="row">
            <input type="hidden"  asp-for="Id" />
            <!-- ========================================= -->
            <!-- Main Column -->
            <!-- ========================================= -->

            <div class="col-xl-8 col-lg-8 col-md-12">

                <!-- Product Information Card -->

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            ویرایش محصول
                        </h5>

                    </div>


                    <div class="card-body">

                        <!-- Validation -->

                        <div asp-validation-summary="All"
                             class="alert alert-danger mb-4">

                            اطلاعات برای ویرایش محصول را وارد کنید

                        </div>


                        <!-- ========================================= -->
                        <!-- Title / Tags -->
                        <!-- ========================================= -->

                        <div class="row">

                            <!-- Title -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="Tittle"
                                       class="form-label">
                                </label>

                                <input asp-for="Tittle"
                                       class="form-control"
                                       placeholder="نام محصول را وارد کنید"
                                       autocomplete="off" />

                                <span asp-validation-for="Tittle"
                                      class="text-danger">
                                </span>

                            </div>

                                   <div class="col-md-6 mb-3">

                                <label asp-for="Slug"
                                       class="form-label">
                                </label>

                                <input asp-for="Slug"
                                       class="form-control"
                                       placeholder="نام Url را وارد کنید"
                                       autocomplete="off" />

                                <span asp-validation-for="Slug"
                                      class="text-danger">
                                </span>

                            </div>
                            <!-- Tags -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="Tags"
                                       class="form-label">
                                </label>

                                <input asp-for="Tags"
                                       type="text"
                                       id="Tags"
                                       class="form-control"
                                       placeholder="تگ‌ها را وارد کنید..."
                                       autocomplete="off" />

                                <span asp-validation-for="Tags"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ========================================= -->
                        <!-- Price / Count -->
                        <!-- ========================================= -->

                        <div class="row">

                            <!-- Price -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="Price"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bx bx-money"></i>

                                    </span>

                                    <input asp-for="Price"
                                           type="number"
                                           class="form-control"
                                           placeholder="قیمت محصول"
                                           min="0"
                                           step="0.01" />

                                </div>

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Count -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="Count"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bx bx-package"></i>

                                    </span>

                                    <input asp-for="Count"
                                           type="number"
                                           class="form-control"
                                           placeholder="تعداد موجودی"
                                           min="0" />

                                </div>

                                <span asp-validation-for="Count"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ========================================= -->
                        <!-- Short Description -->
                        <!-- ========================================= -->

                        <div class="mb-4">

                            <label asp-for="ShortDescript"
                                   class="form-label">
                            </label>

                            <textarea asp-for="ShortDescript"
                                      class="form-control"
                                      rows="4"
                                      placeholder="توضیحات کوتاه محصول را وارد کنید"></textarea>

                            <span asp-validation-for="ShortDescript"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- Detail Description -->
                        <!-- ========================================= -->

                        <div class="mb-4">

                            <label asp-for="DetailReview"
                                   class="form-label">
                            </label>

                            <textarea asp-for="DetailReview"
                                      class="form-control"
                                      rows="7"
                                      placeholder="توضیحات کامل محصول را وارد کنید"></textarea>

                            <span asp-validation-for="DetailReview"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- Review -->
                        <!-- ========================================= -->

                        <div class="mb-4">

                            <label asp-for="Review"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Review"
                                      class="form-control"
                                      rows="7"
                                      placeholder="نقد و بررسی محصول را وارد کنید"></textarea>

                            <span asp-validation-for="Review"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- Category -->
                        <!-- ========================================= -->

                        <div class="card border-0 bg-light mb-4">

                            <div class="card-body">

                                <!-- Category Header -->

                                <div class="d-flex align-items-center mb-4">

                                    <div class="avatar me-3">

                                        <span class="avatar-initial rounded bg-label-primary">

                                            <i class="bx bx-category fs-4"></i>

                                        </span>

                                    </div>

                                    <div>

                                        <h5 class="mb-1">
                                            دسته‌بندی محصول
                                        </h5>

                                        <small class="text-muted">
                                            دسته‌بندی مناسب محصول را انتخاب کنید
                                        </small>

                                    </div>

                                </div>


                                <!-- Category Row -->

                                <div class="row">

                                    <!-- Main Category -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label fw-semibold">
                                            دسته‌بندی اصلی
                                        </label>

                                        <select class="form-select"
                                                id="Main-catgory">

                                            <option value="">
                                                انتخاب گروه اصلی
                                            </option>

                                            @foreach (var item in  (IEnumerable<SelectListItem>)ViewBag.MainCategories)
                                            {
                                                <option value="@item.Value"
                                                        selected="@(item.Selected ? "selected" : null)">
                                                    @item.Text
                                                </option>
                                            }

                                        </select>

                                    </div>


                                    <!-- Sub Category -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label fw-semibold">
                                            دسته‌بندی فرعی
                                        </label>

                                        <select class="form-select"
                                                id="sub-catgory">

                                            <option value="">
                                                انتخاب گروه فرعی
                                            </option>

                                            @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.SubCategories)
                                            {
                                                <option value="@item.Value"
                                                        selected="@(item.Selected ? "selected" : null)">
                                                    @item.Text
                                                </option>
                                            }

                                        </select>

                                    </div>


                                    <!-- Final Category -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label fw-semibold">
                                            دسته‌بندی نهایی
                                        </label>

                                        <select asp-for="CatgoryId"
                                                asp-items="@ViewBag.FinalCategories"
                                                class="form-select"
                                                id="Final-catgory">

                                            <option value="">
                                                انتخاب گروه نهایی
                                            </option>

                                        </select>

                                        <span asp-validation-for="CatgoryId"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ========================================= -->
                        <!-- Product Image + Gallery -->
                        <!-- ========================================= -->

                        <div class="card border-0 bg-light mb-4">

                            <div class="card-body">

                                <!-- Image Header -->

                                <div class="d-flex align-items-center mb-4">

                                    <div class="avatar me-3">

                                        <span class="avatar-initial rounded bg-label-info">

                                            <i class="bx bx-image fs-4"></i>

                                        </span>

                                    </div>

                                    <div>

                                        <h5 class="mb-1">
                                            تصویر محصول
                                        </h5>

                                        <small class="text-muted">
                                            تصویر اصلی محصول را انتخاب کنید
                                        </small>

                                    </div>

                                </div>


                                <!-- Main Image -->

                                <div class="row align-items-center">

                                    <!-- Preview -->

                                    <div class="col-md-3 text-center mb-3 mb-md-0">

                                        <img id="productPreview"
                                             src="~/ProuductImages/Thumb/@Model.ImageName"
                                             alt="تصویر محصول"
                                             class="rounded border shadow-sm"
                                             style="width:140px;
                                        height:140px;
                                        object-fit:cover;" />

                                    </div>


                                    <!-- File -->

                                    <div class="col-md-9">

                                        <label asp-for="FormFile"
                                               class="form-label fw-semibold">
                                        </label>

                                        <input asp-for="FormFile"
                                               type="file"
                                               id="productImageInput"
                                               class="form-control"
                                               accept="image/png,image/jpeg,image/jpg,image/webp" />

                                        <span asp-validation-for="FormFile"
                                              class="text-danger">
                                        </span>

                                        <div class="form-text mt-2">

                                            <i class="bx bx-info-circle me-1"></i>

                                            فرمت‌های مجاز:
                                            JPG، JPEG، PNG، WEBP

                                        </div>

                                    </div>

                                </div>


                                <hr class="my-4" />


                                <!-- Gallery Header -->

                                <div class="d-flex align-items-center mb-4">

                                    <div class="avatar me-3">

                                        <span class="avatar-initial rounded bg-label-info">

                                            <i class="bx bx-images fs-4"></i>

                                        </span>

                                    </div>

                                    <div>

                                        <h5 class="mb-1">
                                            تصاویر گالری
                                        </h5>

                                        <small class="text-muted">
                                            تصاویر گالری محصول را انتخاب کنید
                                        </small>

                                    </div>

                                </div>


                                <!-- Gallery Files -->

                                <div class="row">

                                    <div class="col-12">

                                        <label asp-for="Galleries"
                                               class="form-label fw-semibold">
                                        </label>

                                        <input asp-for="Galleries"
                                               type="file"
                                               id="productGalleryInput"
                                               class="form-control"
                                               multiple
                                               accept="image/png,image/jpeg,image/jpg,image/webp" />

                                        <span asp-validation-for="Galleries"
                                              class="text-danger">
                                        </span>


                                        <!-- Existing Gallery -->
                                        @if (Model.ProuductGalleries != null &&
                                                                                 Model.ProuductGalleries.Any())
                                        {
                                            <div class="row g-3 mt-2">

                                                @foreach (var item in Model.ProuductGalleries)
                                                {
                                                    <div class="col-6 col-sm-4 col-md-3 col-lg-2">

                                                        <div class="card shadow-sm border rounded-3 overflow-hidden h-100">

                                                        <div class="position-relative">

    <img src="/ProuductImages/@item.ImageName"
         alt="تصویر محصول"
         class="img-fluid rounded-2 w-100"
         style="height:140px; object-fit:cover;" />

    <button type="button"
          id="img_@item.Id"
            class="btn btn-danger btn-sm mt-2"
               onclick="DeleteImage(@item.Id)">
        حذف
    </button>

</div>

                                                        </div>

                                                    </div>
                                                }

                                            </div>
                                        }


                                        <div class="form-text mt-2">

                                            <i class="bx bx-info-circle me-1"></i>

                                            امکان انتخاب چند تصویر برای گالری وجود دارد.

                                            فرمت‌های مجاز:
                                            JPG، JPEG، PNG، WEBP

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ========================================= -->
                        <!-- Active -->
                        <!-- ========================================= -->

                        <div class="mb-4">

                            <div class="form-check form-switch">

                                <input asp-for="Active"
                                       class="form-check-input"
                                       type="checkbox" />

                                <label asp-for="Active"
                                       class="form-check-label">
                                </label>

                            </div>

                            <small class="text-muted">
                                در صورت فعال بودن، محصول در فروشگاه قابل نمایش خواهد بود.
                            </small>

                        </div>


                        <hr />


                        <!-- ========================================= -->
                        <!-- Buttons -->
                        <!-- ========================================= -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bx bx-edit me-1"></i>
                                ویرایش محصول

                            </button>


                            <a asp-area="Admin"
                               asp-controller="Prouduct"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bx bx-x me-1"></i>
                                انصراف

                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================================= -->
            <!-- Sidebar -->
            <!-- ========================================= -->

            <div class="col-xl-4 col-lg-4 col-md-12">

                <!-- Product Preview -->

                <div class="card mb-4">

                    <div class="card-body text-center">

                        <div class="mb-3">

                            <div class="avatar avatar-xl mx-auto">

                                <span class="avatar-initial rounded bg-label-primary"
                                      style="width:100px;
                                    height:100px;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;">

                                    <i class="bx bx-package fs-1"></i>

                                </span>

                            </div>

                        </div>


                        <h5 class="mb-1">
                            ویرایش محصول
                        </h5>

                        <p class="text-muted mb-0">
                            اطلاعات محصول را با دقت بررسی و ویرایش کنید.
                        </p>

                    </div>

                </div>


                <!-- Important Information -->

                <div class="card">

                    <div class="card-body">

                        <div class="d-flex align-items-center mb-3">

                            <div class="avatar me-3">

                                <span class="avatar-initial rounded bg-label-info">

                                    <i class="bx bx-info-circle"></i>

                                </span>

                            </div>

                            <h5 class="mb-0">
                                نکات مهم
                            </h5>

                        </div>


                        <ul class="mb-0 ps-3">

                            <li class="mb-2">
                                عنوان محصول را واضح و کوتاه وارد کنید.
                            </li>

                            <li class="mb-2">
                                قیمت محصول باید مقدار معتبر داشته باشد.
                            </li>

                            <li class="mb-2">
                                تعداد موجودی نمی‌تواند منفی باشد.
                            </li>

                            <li class="mb-2">
                                برای تصویر محصول از فرمت‌های مجاز استفاده کنید.
                            </li>

                            <li>
                                قبل از ذخیره، اطلاعات محصول را بررسی کنید.
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </form>
 

</div>

@section Scripts {

  
    <!-- ========================================= -->
    <!-- CKEditor -->
    <!-- ========================================= -->

    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

    <script>

        CKEDITOR.replace('Review');

        CKEDITOR.replace('DetailReview');
       
  function DeleteImage(id) {

    fetch(`/Admin/Prouduct/DeleteImage/${id}`, {
        method: "POST"
    })
    .then(() => {

        setTimeout(() => {
            document.getElementById(`img_${id}`)
                .parentElement.remove();
        }, 1000);

    });
}
    </script>

  <script>  

    <!-- ========================================= -->
    <!-- Validation -->
    <!-- ========================================= -->

    <partial name="_ValidationScriptsPartial" />


    <!-- ========================================= -->
    <!-- Main Image Preview -->
    <!-- ========================================= -->

    <script>



        const imageInput =
            document.getElementById('productImageInput');

        const imagePreview =
            document.getElementById('productPreview');


        if (imageInput && imagePreview) {

            imageInput.addEventListener('change', function(event) {

                const file =
                    event.target.files[0];

                if (file) {

                    imagePreview.src =
                        URL.createObjectURL(file);

                }

            });

        }

    </script>


    <!-- ========================================= -->
    <!-- Category JavaScript -->
    <!-- ========================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const mainCategory =
                document.getElementById("Main-catgory");

            const subCategory =
                document.getElementById("sub-catgory");

            const finalCategory =
                document.getElementById("Final-catgory");


            if (!mainCategory ||
                !subCategory ||
                !finalCategory) {

                return;

            }


            /*
             * فعلاً هنگام باز شدن صفحه
             * هیچ Fetch انجام نمی‌دهیم.
             *
             * Controller خودش دسته‌بندی‌های
             * فعلی محصول را قرار داده است.
             */


            // =========================================
            // تغییر دسته‌بندی اصلی
            // =========================================

            mainCategory.addEventListener("change", function() {

                const parentId =
                    this.value;


                subCategory.innerHTML =
                    '<option value="">انتخاب گروه فرعی</option>';

                finalCategory.innerHTML =
                    '<option value="">انتخاب گروه نهایی</option>';


                if (parentId === "") {

                    return;

                }


                fetch(
                    `/Admin/Catgory/GetCatgories?parentid=${parentId}`
                )
                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "خطا در دریافت دسته‌بندی فرعی"
                            );

                        }

                        return response.json();

                    })
                    .then(data => {

                        data.forEach(item => {

                            const option =
                                document.createElement("option");

                            option.value =
                                item.id;

                            option.textContent =
                                item.tittle;

                            subCategory.appendChild(option);

                        });

                    })
                    .catch(error => {

                        console.error(error);

                    });

            });


            // =========================================
            // تغییر دسته‌بندی فرعی
            // =========================================

            subCategory.addEventListener("change", function() {

                const parentId =
                    this.value;


                finalCategory.innerHTML =
                    '<option value="">انتخاب گروه نهایی</option>';


                if (parentId === "") {

                    return;

                }


                fetch(
                    `/Admin/Catgory/GetCatgories?parentid=${parentId}`
                )
                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "خطا در دریافت دسته‌بندی نهایی"
                            );

                        }

                        return response.json();

                    })
                    .then(data => {

                        data.forEach(item => {

                            const option =
                                document.createElement("option");

                            option.value =
                                item.id;

                            option.textContent =
                                item.tittle;

                            finalCategory.appendChild(option);

                        });

                    })
                    .catch(error => {

                        console.error(error);

                    });

            });

        });

    </script>


    <!-- ========================================= -->
    <!-- Tagify -->
    <!-- ========================================= -->

    <script src="~/AdminAssests/assets/vendor/libs/tagify/tagify.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const input =
                document.getElementById("Tags");


            if (input &&
                typeof Tagify !== "undefined") {

                new Tagify(input);

            }

        });

    </script>


}
