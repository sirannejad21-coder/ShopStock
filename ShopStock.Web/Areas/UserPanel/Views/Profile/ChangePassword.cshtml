@using ShopStock.Domain.ViewModels.Account

@model ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="auth-container">

    <div class="auth-title mb-3">
        تغییر رمز عبور
    </div>

    <div class="auth-box ui-box">

        <form asp-action="ChangePassword"
              method="post"
              class="auth-form">

            @Html.AntiForgeryToken()

            <!-- رمز عبور قدیمی -->
            <div class="form-element-row mb-3">

               

                <input asp-for="OldPassword"
                       type="password"
                       class="form-control"
                       placeholder="رمز عبور فعلی را وارد کنید"
                       autocomplete="current-password" />

                <span asp-validation-for="OldPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- رمز عبور جدید -->
            <div class="form-element-row mb-3">

                <label asp-for="Password" class="form-label">
                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="رمز عبور جدید را وارد کنید"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>


            <!-- تکرار رمز عبور -->
            <div class="form-element-row mb-3">

                <label asp-for="RePassword" class="form-label">
                </label>

                <input asp-for="RePassword"
                       type="password"
                       class="form-control"
                       placeholder="رمز عبور جدید را دوباره وارد کنید"
                       autocomplete="new-password" />

                <span asp-validation-for="RePassword"
                      class="text-danger">
                </span>

            </div>


            <!-- خطاهای کلی -->
            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>


            <!-- دکمه -->
            <div class="form-element-row mb-3">

                <button type="submit"
                        class="btn btn-primary">
                    تغییر رمز عبور
                </button>

            </div>

        </form>

    </div>

</div>


