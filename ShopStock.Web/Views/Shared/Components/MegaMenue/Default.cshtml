@using ShopStock.Domain.Models.Catgories
@model IEnumerable<Catgory>
<div class="vertical-menu">

    <div class="vertical-menu-items">
        <ul>
            @{
                bool isShow = false;
            }
            @* show *@
            @foreach (var parent in Model.Where(c => c.ParentId == null))
            {
                <li class="mega-menu-category @((!isShow) ? "show" : "")">
                    @{
                        isShow = true;
                    }
                    <a href="/Category/@parent.Slug">@parent.Tittle</a>
                    @if (Model.Any(c => c.ParentId == parent.Id))
                    {
                        <ul class="mega-menu">
                            @foreach (var category in Model.Where(c => c.ParentId == parent.Id))
                            {
                                <li class="parent"><a href="/Category/@category.Slug">@category.Tittle</a></li>
                                @if (Model.Any(c => c.ParentId == category.Id))
                                {
                                    foreach (var subCategory in Model.Where(c => c.ParentId == category.Id))
                                    {
                                        <li><a href="/Category/@subCategory.Slug">@subCategory.Tittle</a></li>
                                    }
                                }
                            }
                        </ul>
                    }
                </li>

            }

        </ul>
    </div>
</div>