

@model bool 

@if (Model==true)
{
    <div class="alert alert-warning alert-dismissible fade show mb-5" role="alert">
        <div>
            جهت استفاده از همه امکانات پروفایل را کامل کنید
            <a asp-area="userpanel" asp-controller="profile" class="btn btn-sm btn-primary mx-3">پروفایل من</a>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}