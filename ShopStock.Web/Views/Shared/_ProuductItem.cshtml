@using ShopStock.Domain.Models.Prouducts
@model Prouduct
@*Line 813 Index *@
<div class="product-card">
    <div class="product-thumbnail">
        <a href="#">
            <img src="/ProuductImages/@Model.ImageName" style="height:155px" alt="product title">
        </a>
    </div>
    <div class="product-card-body">
        <h2 class="product-title">
            <a asp-controller="Prouduct" asp-action="ShowProuduct" asp-route-id="@Model.Id">
                @Model.Tittle
            </a>
        </h2>
        @if (Model.ProuductColors != null && Model.ProuductColors.Any())
        {
            <div class="product-variant">
                @foreach (var color in Model.ProuductColors.Take(3))
                {
                    <span class="color" style="background-color: @color.Code;"></span>

                }
                @if (Model.ProuductColors.Count() > 3)
                {
                    <span>+</span>
                }

            </div>
        }
        <div class="product-price fa-num">
            @*   <div class="d-flex align-items-center">
                                        <del class="price-old">26,900,000</del>
                                        <span class="discount ms-2">%2</span>
                                    </div> *@
            <span class="price-now">
                @{
                    double price = Model.Price;
                    if (Model.ProuductColors != null && Model.ProuductColors.Any())
                    {
                        price = Model.ProuductColors
                        .Where(p => p.IsDefult).First().Price;
                    }
                }
                @price.ToToman() <span class="currency">تومان</span>
            </span>
        </div>
    </div>
    <div class="product-card-footer">
        <div class="d-flex align-items-center justify-content-between border-top mt-2 py-2">
            <div class="product-actions">
                <ul>
                    <li>
                        <a href="#" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="" data-bs-original-title="افزودن به سبد خرید"
                           aria-label="افزودن به سبد خرید">
                            <i class="ri-shopping-cart-line"></i>
                        </a>
                    </li>
                    <li>
                        <a onclick="ShowDescModal(@Model.Id)" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="" data-bs-original-title="مشاهده سریع"
                           aria-label="مشاهده سریع"
                           data-remodal-target="quick-view-modal">
                            <i class="ri-search-line"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="" data-bs-original-title="افزودن به علاقمندی"
                           aria-label="افزودن به علاقمندی">
                            <i class="ri-heart-3-line"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="product-rating fa-num">
                <i class="ri-star-fill star"></i>
                <strong>۴.۴</strong>
                <span>(۴۳۶)</span>
            </div>
        </div>
    </div>
</div>
