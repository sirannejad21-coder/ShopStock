@using ShopStock.Application.Services.Implitation
@using ShopStock.Application.Services.Interfaces
@using ShopStock.Domain.Models.Catgories
@inject ICatgoryService _categoryService
@{
    var data = await _categoryService.GetAllCatgoryForMegaAsync();
}

<div class="ui-box mb-5">
    <div class="ui-box-title">دسته بندی محصولات</div>
    <div class="ui-box-content">
        <div class="categories-container">
            <!-- Slider main container -->
            <div class="swiper category-swiper-slider pb-5">
                <!-- Additional required wrapper -->
                <div class="swiper-wrapper">
                    <!-- Slides -->
                    @foreach (var item in data.Where(c => c.ParentId == null))
                    {
                        <div class="swiper-slide">
                            <div class="category-item">
                                <a href="/Category/@item.Slug">
                                    <img src="/CatgoriesImage/@item.ImageName" class="category-img"
                                         alt="@item.Tittle">
                                    <span class="category-title">@item.Tittle</span>
                                </a>
                            </div>
                        </div>
                    }

                </div>
                <!-- If we need pagination -->
                <div class="swiper-pagination"></div>

                <!-- If we need navigation buttons -->
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            </div>
        </div>
    </div>
</div>