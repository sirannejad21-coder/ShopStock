```cshtml
@using ShopStock.Domain.ViewModels.Account

@model LoginViewModel

@{
    ViewData["Title"] = "ورود";
}

<style>

    /* =========================
       CAPTCHA
    ========================= */

    .captcha-container {
        width: 100%;
        margin-top: 5px;
    }

    .captcha-container img {
        width: 220px !important;
        height: 65px !important;
        display: block;
        object-fit: contain;
        margin-bottom: 10px;
    }

    .captcha-container input[type="text"] {
        width: 100%;
        height: 48px;
        padding: 8px 12px;
        font-size: 17px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        box-sizing: border-box;
    }

    .captcha-container input[type="text"]:focus {
        border-color: #86b7fe;
        outline: none;
        box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.15);
    }

    .captcha-container button {
        height: 48px;
        min-width: 48px;
        margin-right: 8px;
        border-radius: 6px;
        font-size: 16px;
    }

    .captcha-container .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 13px;
    }

</style>


<div class="auth-container">

    <div class="auth-title mb-3">
        ورود
    </div>

    <div class="auth-box ui-box">

        <form asp-controller="Account"
              asp-action="Login"
              method="post"
              class="auth-form"
              autocomplete="off">

            <input type="hidden"
                   name="ReturnUrl"
                   value="@ViewBag.ReturnUrl" />


            <!-- نام کاربری یا ایمیل -->
            <div class="form-element-row mb-3">

                <input asp-for="UserNameOrEmail"
                       type="text"
                       class="form-control"
                       placeholder="نام کاربری یا ایمیل را وارد کنید"
                       autocomplete="off" />

                <span asp-validation-for="UserNameOrEmail"
                      class="text-danger">
                </span>

            </div>


            <!-- رمز عبور -->
            <div class="form-element-row mb-3">

                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="کلمه عبور را وارد کنید"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>


            <!-- کپچا -->
            <div class="form-element-row mb-3">

                <div class="captcha-container">

                    <dnt-captcha asp-captcha-generator-max="999999"
                                 asp-captcha-generator-min="111111"
                                 asp-captcha-generator-language="English"
                                 asp-captcha-generator-display-mode="ShowDigits"
                                 asp-use-relative-urls="true"
                                 asp-placeholder="کد امنیتی را وارد کنید"
                                 asp-validation-error-class="text-danger"
                                 asp-validation-message-class="text-danger"
                                 asp-refresh-button-enabled="true"
                                 asp-refresh-button-class="btn btn-secondary"
                                 asp-use-noise="false"
                                 asp-font-size="32"
                                 asp-fore-color="#222222"
                                 asp-back-color="#f5f5f5">
                    </dnt-captcha>

                </div>

            </div>


            <!-- مرا به خاطر بسپار -->
            <div class="row mb-3">

                <div class="col-1 pt-1">

                    <input asp-for="RememberMe"
                           class="form-check" />

                </div>

                <div class="col-10">

                    <p>مرا به خاطر بسپار</p>

                </div>

            </div>


            <!-- دکمه ورود -->
            <div class="form-element-row mb-3">

                <button type="submit"
                        class="btn btn-primary">
                    ورود
                </button>

            </div>


            <!-- خطاهای کلی -->
            <div asp-validation-summary="All"
                 class="text-danger">
            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

